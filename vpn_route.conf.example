# =============================================================================
# VPN 路由配置示例 (已脱敏)
# 复制为 ~/.vpn_route.conf (或通过 -c / 环境变量 VPN_ROUTE_CONF 指定) 并按需修改
# 以下所有 IP/网段/域名均为占位符，请替换为你自己环境的真实值
# =============================================================================

# --- 物理网络接口 (macOS 网络服务名，networksetup 用) ---
WIFI_SERVICE="Wi-Fi"

# --- DNS 服务器 ---
# 顺序敏感：先公网后内网，防止内网 DNS 故障导致无法上网
DNS_SERVERS=("8.8.8.8" "8.8.4.4" "10.20.0.53")

# --- 需要清理的旧路由 (apply 前会先删除，防止上次残留) ---
CLEANUP_NETS=("10.20.0.0/24" "10.30.0.0/24")
CLEANUP_HOSTS=("10.20.1.10" "10.20.1.11")

# =============================================================================
# VPN 定义 (支持任意数量)
# =============================================================================
# VPN_NAMES 为所有 VPN 名称列表 (建议小写英文)
# 每个名称 N 在脚本内部转大写后对应以下变量:
#   N_DETECT_SUBNET  识别特征，该 VPN 网卡 IP 所在网段前缀 (如 "10.8")
#   N_ROUTE_NETS     走该 VPN 的网段数组 (CIDR)
#   N_ROUTE_HOSTS    走该 VPN 的单机 IP 数组 (不在网段内的主机)

VPN_NAMES=("vpn_a" "vpn_b")

# --- VPN A ---
# 识别特征：网卡 IP 形如 10.8.x.x
VPN_A_DETECT_SUBNET="10.8"
VPN_A_ROUTE_NETS=("10.20.0.0/24")
VPN_A_ROUTE_HOSTS=("10.20.1.10" "10.20.1.11")

# --- VPN B ---
# 识别特征：网卡 IP 形如 10.9.x.x
VPN_B_DETECT_SUBNET="10.9"
VPN_B_ROUTE_NETS=("10.30.0.0/24")
VPN_B_ROUTE_HOSTS=()

# 增加新 VPN 只需: 1) 追加到 VPN_NAMES  2) 定义 XXX_DETECT_SUBNET / XXX_ROUTE_NETS / XXX_ROUTE_HOSTS

# =============================================================================
# 连通性测试 (apply 结束后自动运行；也可通过 test 子命令单独运行)
# =============================================================================
# 格式: "描述|目标|类型|端口"
# 类型:
#   public  公网测试 (ping，失败时 HTTP 兜底)
#   tcp     TCP 端口测试 (端口不通时 ping 兜底)
#   domain  域名测试 (先解析；内网 IP 测 TCP，公网 IP 测 ping/HTTPS)
TESTS=(
    "公网访问|example.com|public|0"
    "VPN_A资源|10.20.0.5|tcp|80"
    "VPN_B资源|10.30.0.5|tcp|80"
    "内网域名|intranet.example.com|domain|443"
)
